<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Events to the Music app, when the settings add encoded files to it. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Silverside adds the files it encodes to your Music library, when you turn this on in Settings.</string>
	<!-- AccurateRip and CUETools DB are plain HTTP. Every other service uses HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>www.accuraterip.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>db.cuetools.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>p.cuetools.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Sparkle: the feed of versions, and the public half of the key that signs the feed and each
	     update (the private half is in the Keychain of the Mac that runs make dist, and backed up).
	     Only a build that make dist made checks for updates (AppUpdater). -->
	<key>SUFeedURL</key>
	<string>https://silverside.app/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>y9xmISyIi7T8tB18Y3AUBogJU33ELvdA8xGI1VqAJJo=</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
